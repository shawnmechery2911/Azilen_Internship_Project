# Copy to .env and fill in the token. Never commit real credentials.
#
# BEDROCK_MODEL_ID must be a real inference profile id, not a placeholder -
# an invalid one fails at the first call with "The provided model identifier
# is invalid". List what your account can reach with:
#   aws bedrock list-inference-profiles --region us-east-2
AWS_REGION=us-east-2
AWS_BEARER_TOKEN_BEDROCK=replace-with-your-local-token
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
